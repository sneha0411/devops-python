pipeline {
  agent {
    kubernetes {
      yaml """
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins-ksa
  containers:
  - name: terraform
    image: google/cloud-sdk:slim
    command:
    - cat
    tty: true
"""
    }
  }

  environment {
    PROJECT_ID       = "project-b9c15744-8559-4eae-9ba"
    TF_IN_AUTOMATION = "true"
    TF_INPUT         = "false"
  }

  stages {

    stage('Verify GCP Identity (DEBUG)') {
      steps {
        container('terraform') {
          sh '''
            echo "=== GCP AUTH DEBUG ==="
            gcloud auth list || true
            gcloud config list || true
          '''
        }
      }
    }


    stage('Install Terraform') {
      steps {
        container('terraform') {
          sh '''
            set -e

            TERRAFORM_VERSION=1.7.5

            apt-get update -y
            apt-get install -y unzip curl

            curl -fsSL https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_amd64.zip -o terraform.zip
            unzip terraform.zip
            mv terraform /usr/local/bin/

            terraform version
          '''
    }
  }
}


    stage('Checkout Code') {
      steps {
        checkout scm
      }
    }

    stage('Terraform Init') {
      steps {
        container('terraform') {
          sh '''
            cd terraform
            terraform init
          '''
        }
      }
    }

    stage('Terraform Validate') {
      steps {
        container('terraform') {
          sh '''
            cd terraform
            terraform validate
          '''
        }
      }
    }

    stage('Terraform Plan') {
      steps {
        container('terraform') {
          sh '''
            cd terraform
            terraform plan
          '''
        }
      }
    }

    stage('Terraform Apply') {
      steps {
        container('terraform') {
          sh '''
            cd terraform
            terraform apply -auto-approve
          '''
        }
      }
    }
  }
}
