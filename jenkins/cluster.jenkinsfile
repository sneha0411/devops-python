pipeline {
  agent {
    kubernetes {
      yaml """
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins-ksa
  containers:
  - name: terraform
    image: hashicorp/terraform:1.7
    command:
    - cat
    tty: true
"""
    }
  }

  environment {
    PROJECT_ID = "project-b9c15744-8559-4eae-9ba"
    SA_EMAIL   = "gke-cluster-sa@project-b9c15744-8559-4eae-9ba.iam.gserviceaccount.com"
    TF_IN_AUTOMATION = "true"
    TF_INPUT         = "false"
  }

  stages {


    stage('Authenticate to GCP via WIF') {
      steps {
        sh '''
          export GOOGLE_APPLICATION_CREDENTIALS=/tmp/gcp-wif-creds.json
        '''
      }
    }

    stage('Checkout Code') {
      steps {
        checkout scm
      }
    }

    stage('Terraform Init') {
      steps {
        container('terraform') {
          sh '''
            cd terraform
            terraform init
          '''
        }
      }
    }

    stage('Terraform Validate') {
      steps {
        container('terraform') {
          sh '''
            cd terraform
            terraform validate
          '''
        }
      }
    }

    stage('Terraform Plan') {
      steps {
        container('terraform') {
          sh '''
            cd terraform
            terraform plan
          '''
        }
      }
    }

    stage('Terraform Apply') {
 
      steps {
        container('terraform') {
          sh '''
            cd terraform
            terraform apply -auto-approve
          '''
        }
      }
    }
  }
}
