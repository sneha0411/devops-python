pipeline {
  agent {
    kubernetes {
      yaml """
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins-ksa
  containers:
  - name: terraform
    image: us-central1-docker.pkg.dev/project-b9c15744-8559-4eae-9ba/python-app/gcloud-terraform:3.0
    command: ["cat"]
    tty: true
"""
    }
  }

  environment {
    PROJECT_ID = "project-b9c15744-8559-4eae-9ba"
    CLUSTER    = "jenkins-cluster"
    LOCATION   = "us-central1-a"
  }

  options {
    disableConcurrentBuilds()
  }

  stages {

    stage('Activate GSA via Workload Identity') {
      steps {
        container('terraform') {
          sh '''
            set -e
            echo "Using Workload Identity GSA"
            gcloud config set project ${PROJECT_ID}
            gcloud auth list
            gcloud config set account jenkins-gsa@project-b9c15744-8559-4eae-9ba.iam.gserviceaccount.com
          '''
        }
      }
    }

    stage('Authenticate to GKE') {
      steps {
        container('terraform') {
          sh '''
            set -e

            echo "Installing kubectl and GKE auth plugin via apt"
            apt-get update -y
            apt-get install -y \
              kubectl \
              google-cloud-cli-gke-gcloud-auth-plugin

            echo "Verify installs"
            kubectl version --client
            gke-gcloud-auth-plugin --version

            echo "Fetching cluster credentials"
            gcloud container clusters get-credentials jenkins-cluster \
              --zone us-central1-a \
              --project project-b9c15744-8559-4eae-9ba

            echo "Validating cluster access"
            kubectl get nodes
          '''
        }
      }
    }

    stage('Terraform Init') {
      steps {
        container('terraform') {
          sh '''
            cd terraform
            terraform init
          '''
        }
      }
    }

    stage('Terraform Plan') {
      steps {
        container('terraform') {
          sh '''
            cd terraform
            terraform plan
          '''
        }
      }
    }

    stage('Terraform Apply') {
      steps {
        container('terraform') {
          sh '''
            cd terraform
            terraform apply -auto-approve
          '''
        }
      }
    }
  }
}
